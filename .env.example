# Comma-separated keys for "Authorization: Bearer <key>". Leave empty only for local development.
SCOUT_API_KEYS=""
SCOUT_RATE_LIMIT_PER_MINUTE=30
# Sent with every page fetch. Add a "+https://..." link to your README if you want sites to know who you are.
SCOUT_USER_AGENT="ScoutLinkPreview/0.1 (+link preview; one fetch per user request)"

# Groq, for pages without structured data. Without a key the import still works on structured pages.
GROQ_API_KEY=""
GROQ_TEXT_MODEL="openai/gpt-oss-120b"
# "true" = deterministic fake model (tests, offline demos)
AI_MOCK="false"

# GST registry for vendor checks: "none" (offline checks only) or "fixture" (labelled demo data)
GST_REGISTRY="none"
